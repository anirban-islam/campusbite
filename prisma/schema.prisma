generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  authorId  String   @db.Char(36)
  content   String?
  createdAt DateTime @db.Timestamptz(6)
  id        String   @id @db.Char(36)
  title     String
  updatedAt DateTime @db.Timestamptz(6)
}

model User {
  createdAt DateTime @db.Timestamptz(6)
  email     String   @unique
  id        String   @id @db.Char(36)
  name      String?
  updatedAt DateTime @db.Timestamptz(6)
  username  String?
}
